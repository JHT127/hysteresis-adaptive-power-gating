; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 25 1366 412 225 1

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "/home/st160/VLSI-Project/vlsi-project/tb_comparison.vcd.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ns

; waveform viewport range
zoom 965.041117 2013.617117 1n
cursor 0.000000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 4

; rename signal list
; addRenameSig new_name org_name
activeDirFile "" "/home/st160/VLSI-Project/vlsi-project/tb_comparison.vcd.fsdb"

addRenameSig "/tb_comparison/dut_baseline/power_mode (baseline)" "/tb_comparison/dut_baseline/power_mode[1:0]"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_comparison/dut_proposed/power_mode (proposed)" "/tb_comparison/dut_proposed/power_mode[1:0]"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_comparison/dut_baseline/sleep_n (baseline)" "/tb_comparison/dut_baseline/sleep_n"

; rename signal list
; addRenameSig new_name org_name

addRenameSig "/tb_comparison/dut_proposed/sleep_n (proposed)" "/tb_comparison/dut_proposed/sleep_n"

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "/home/st160/VLSI-Project/vlsi-project/tb_comparison.vcd.fsdb"
addSignal -h 15 -UNSIGNED -HEX /tb_comparison/dut_baseline/power_mode (baseline)
addSignal -h 15 -UNSIGNED -HEX /tb_comparison/dut_proposed/power_mode (proposed)
addSignal -h 15 /tb_comparison/dut_baseline/sleep_n (baseline)
addSignal -h 15 /tb_comparison/dut_proposed/sleep_n (proposed)
addGroup "G2"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm
activeDirFile "" "/home/st160/VLSI-Project/vlsi-project/tb_comparison.vcd.fsdb"

GETSIGNALFORM_SCOPE_HIERARCHY_BEGIN
getSignalForm close

"/tb_comparison"

