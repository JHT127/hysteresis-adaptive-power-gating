# =============================================================================
# Synopsys / EDA tool session & crash artifacts
# These are auto-generated on every tool invocation (or on crash) and dropped
# into the working directory. They carry no information about the design
# itself and, on a shared license server, can incidentally reveal other
# users' session data. Never worth versioning.
# =============================================================================
*.svf
crte_*.txt
Synopsys_stack_trace_*.txt
filenames_*.log
opendatabase.log

# =============================================================================
# Design Compiler / ICC2 regenerable caches & compiled libraries
# Binary, tool-version-specific, not portable, not human-readable.
# The actual deliverables (netlists, reports) already live elsewhere.
# =============================================================================
alib-52/
*.dlib/
*.mr

# =============================================================================
# Verdi / VCS GUI session state and local-path leakage
# =============================================================================
verdiLog/
vfastLog/
novas.rc
novas.conf

# =============================================================================
# Compiled simulation binaries / build artifacts
# =============================================================================
simv
simv_*
simv_*.daidir/
*.daidir/
csrc/
ucli.key
*.vcd
*.vpd
*.key
DVEfiles/

# =============================================================================
# Binary waveform dumps
# Not human-readable and regenerated by scripts/run_sim*.sh; if you want a
# waveform visible in the repo, export a screenshot into figures/ instead.
# =============================================================================
*.fsdb

# =============================================================================
# Never publish (private links / sensitive references)
# =============================================================================
sci-hub-proxy-search-links.txt
overleaf-link.txt
vlsi-papers-drive-link.txt

